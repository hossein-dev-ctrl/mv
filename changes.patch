+"use client";
+import {useState} from 'react';
+import {useRouter} from 'next/navigation';
+import CertificateDocument from '@/components/assessment/certificate-document';
+import {defaultDesign,styleLabels,type CertificateDesign} from '@/lib/certificate-templates';
+import ThemeIcon from '@/components/panel/theme-icon';
+export function TemplateEditor({initial,previewDate}:{initial?:CertificateDesign&{id:string};previewDate:string}){
