+import Link from 'next/link';
+import {redirect} from 'next/navigation';
+import {getManagementSession} from '@/lib/management-session';
+import {prisma} from '@/lib/prisma';
+import {SmsForm,SmsRunner} from '@/components/communication/admin-tools';
+import StartSmsControl from '@/components/course/start-sms-control';
+export default async function SmsPage({searchParams}:{searchParams:Promise<{page?:string;campaign?:string;after?:string}>}){
+ if((await getManagementSession())?.role!=='ADMIN')redirect('/login');
+ const query=await searchParams;const page=Math.max(1,Math.min(10000,Number(query.page)||1));
+ const [courses,campaigns,details]=await Promise.all([
+ prisma.course.findMany({where:{demoBatchId:null,status:'PUBLISHED',deliveryStatus:'ONGOING',interests:{some:{}}},select:{id:true,title:true,_count:{select:{interests:true}}},orderBy:{updatedAt:'desc'}}),
+ prisma.smsCampaign.findMany({orderBy:{createdAt:'desc'},skip:(Math.floor(page)-1)*20,take:21,include:{_count:{select:{deliveries:true}}}}),
