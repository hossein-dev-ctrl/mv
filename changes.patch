+export function CertificateButton({enrollmentId}:{enrollmentId:string}){const [busy,setBusy]=useState(false),[message,setMessage]=useState('');const router=useRouter();return <div className="mt-5 rounded-2xl border border-indigo-100 bg-indigo-50/50 p-5"><h3 className="mb-3 font-bold">گواهی‌نامهٔ پایان دوره</h3><p className="mb-4 text-sm leading-8">پس از تکمیل درس‌ها، تصحیح همهٔ تمرین‌ها و کسب حداقل نمرهٔ ۶۰ در آزمون و کارنامهٔ نهایی، گواهی دو‌زبانهٔ قابل استعلام صادر می‌شود. نام و عنوان دوره به زبان ثبت‌شده نمایش داده می‌شوند.</p><button disabled={busy} className="panel-action panel-action-primary" onClick={async()=>{setBusy(true);setMessage('');try{const res=await fetch('/api/certificates',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({enrollmentId})});const data=await res.json();if(!res.ok)throw Error(data.message);router.push(`/certificates/${data.id}`);}catch(e){setMessage(e instanceof Error?e.message:'خطا');}finally{setBusy(false);}}}><ThemeIcon name="award" className="h-5 w-5"/>{busy?'در حال بررسی…':'دریافت گواهی‌نامه'}</button><p role="status" className="mt-3 text-sm">{message}</p></div>;}
