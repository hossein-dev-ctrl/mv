generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonStatus {
  DRAFT
  PUBLISHED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

model User {
  notifications Notification[]
  ticketsCreated Ticket[] @relation("TicketCreator")
  ticketsReceived Ticket[] @relation("TicketRecipient")
  ticketMessages TicketMessage[]
  notificationDispatches NotificationDispatch[]
  demoBatchId String?
  id           String   @id @default(cuid())
  name         String?
  phone        String?  @unique
  email        String?  @unique
  teacherSharePercent Int?
  passwordHash String?
  role         UserRole @default(STUDENT)

  interests CourseInterest[]
  payouts     Payout[]
  courses     Course[]
  enrollments Enrollment[]
  payments    Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  deliveryStatus String @default("ONGOING")
  teacherIntro String?
  interests CourseInterest[]
  demoBatchId String?
  discountPercent Int @default(0)
  id        String @id @default(cuid())
  teacherId String

  title            String
  slug             String  @unique
  shortDescription String?
  description      String?
  thumbnailUrl     String?
  roadmapImageUrl  String?

  price  Int          @default(0)
  status CourseStatus @default(DRAFT)

  teacher User @relation(fields: [teacherId], references: [id])

  sections    CourseSection[]
  enrollments Enrollment[]
  payments    Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseSection {
  id       String @id @default(cuid())
  courseId String

  title       String
  description String?
  order       Int

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, order])
}

model LessonFile {
  id       String @id @default(cuid())
  lessonId String

  name String
  url  String
  type String?
  size Int?

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Enrollment {
  submissions Submission[]
  id       String @id @default(cuid())
  userId   String
  courseId String

  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  progresses LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
}

model LessonProgress {
  id String @id @default(cuid())

  enrollmentId String
  lessonId String

  status LessonProgressStatus @default(NOT_STARTED)

  startedAt DateTime?
  completedAt DateTime?

  videoCompletedAt DateTime?

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, lessonId])
}

model Payment {
  id       String @id @default(cuid())
  userId   String
  courseId String

  refund PaymentRefund?
  cost PaymentCost?
  teacherSharePercent Int?
  teacherShareAmount  Int?
  isTest             Boolean?

  amount        Int
  authority     String? @unique
  transactionId String? @unique

  status PaymentStatus @default(PENDING)
  paidAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lesson {
  assignment Assignment?
  id        String @id @default(cuid())
  sectionId String

  title         String
  description   String?
  videoUrl      String?
  videoDuration Int?
  order         Int
  status        LessonStatus @default(DRAFT)

  section CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  files      LessonFile[]
  progresses LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionId, order])
}

model FinanceSettings {
  id String @id @default("main")
  minimumPayout Int?
  updatedAt DateTime @updatedAt
}

model Payout {
  reviews PayoutReview[]
  disputedAt DateTime?
  disputeReason String?
  reviewedAt DateTime?
  reviewNote String?
  id String @id @default(cuid())
  teacherId String
  teacher User @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  amount Int
  status String @default("REQUESTED")
  iban String
  accountName String
  fee Int @default(0)
  reference String? @unique
  note String?
  requestedAt DateTime @default(now())
  cutoffAt DateTime @default(now())
  paidAt DateTime?
  receivedAt DateTime?
  processedBy String?
  @@index([teacherId, status])
}

model PaymentRefund {
  id String @id @default(cuid())
  paymentId String @unique
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount Int
  teacherDebit Int
  reference String @unique
  reason String
  refundedAt DateTime
  createdAt DateTime @default(now())
  createdBy String
}

model PaymentCost {
  id String @id @default(cuid())
  paymentId String @unique
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount Int
  createdAt DateTime @default(now())
  createdBy String
}

model DemoBatch {
  id String @id
  ownerId String @unique
  teacherId String @unique
  createdAt DateTime @default(now())
}

model CourseInterest {
 id String @id @default(cuid())
 courseId String
 userId String
 name String
 phone String
 createdAt DateTime @default(now())
 course Course @relation(fields:[courseId],references:[id],onDelete:Cascade)
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@unique([courseId,userId])
 @@index([courseId,createdAt])
}

model PayoutReview {
 id String @id @default(cuid())
 payoutId String
 actorId String
 action String
 message String
 createdAt DateTime @default(now())
 payout Payout @relation(fields:[payoutId],references:[id],onDelete:Cascade)
 @@index([payoutId,createdAt])
}

model Assignment {
 id String @id @default(cuid())
 lessonId String @unique
 lesson Lesson @relation(fields:[lessonId],references:[id],onDelete:Cascade)
 title String
 instructions String
 published Boolean @default(false)
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 submissions Submission[]
}
model Submission {
 isLatest Boolean @default(true)
 id String @id @default(cuid())
 assignmentId String
 assignment Assignment @relation(fields:[assignmentId],references:[id],onDelete:Restrict)
 enrollmentId String
 enrollment Enrollment @relation(fields:[enrollmentId],references:[id],onDelete:Cascade)
 attempt Int
 answer String
 projectUrl String?
 assignmentTitle String
 assignmentInstructions String
 status String @default("PENDING")
 score Int?
 feedback String?
 reviewedBy String?
 reviewedAt DateTime?
 createdAt DateTime @default(now())
 @@unique([assignmentId,enrollmentId,attempt])
 @@index([assignmentId,status,createdAt])
 @@index([enrollmentId])
}

model Ticket {
 id String @id @default(cuid())
 creatorId String
 recipientId String?
 subject String
 status String @default("OPEN")
 clientRequestId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 creator User @relation("TicketCreator",fields:[creatorId],references:[id],onDelete:Restrict)
 recipient User? @relation("TicketRecipient",fields:[recipientId],references:[id],onDelete:Restrict)
 messages TicketMessage[]
 @@unique([creatorId,clientRequestId])
 @@index([creatorId,updatedAt])
 @@index([recipientId,updatedAt])
 @@index([status,updatedAt])
}

model TicketMessage {
 id String @id @default(cuid())
 ticketId String
 senderId String
 body String
 clientRequestId String
 createdAt DateTime @default(now())
 ticket Ticket @relation(fields:[ticketId],references:[id],onDelete:Cascade)
 sender User @relation(fields:[senderId],references:[id],onDelete:Restrict)
 @@unique([ticketId,senderId,clientRequestId])
 @@index([ticketId,createdAt])
}

model Notification {
 id String @id @default(cuid())
 userId String
 title String
 body String
 href String
 eventKey String
 readAt DateTime?
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@unique([userId,eventKey])
 @@index([userId,readAt,createdAt])
}

model NotificationDispatch {
 id String @id
 senderId String
 title String
 body String
 audience String
 targetId String?
 recipientCount Int
 createdAt DateTime @default(now())
 sender User @relation(fields:[senderId],references:[id],onDelete:Restrict)
 @@index([createdAt])
}
